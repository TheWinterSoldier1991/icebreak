# Firebase Web app configuration (these values identify the app; never put
# service account credentials or Plaid secrets in NEXT_PUBLIC variables).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-west1

# Set to true only when using the Firebase Emulator Suite locally.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
