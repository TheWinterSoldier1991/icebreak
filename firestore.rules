rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile and budget collections are readable only by their owner.
    // All writes go through authenticated Cloud Functions using the Admin SDK,
    // where monetary amounts and category allocations are validated atomically.
    match /users/{userId} {
      allow get: if signedInAs(userId);
      allow list, create, update, delete: if false;

      match /{collection}/{document=**} {
        allow read: if signedInAs(userId)
          && collection in ['categories', 'transactions', 'goals'];
        allow write: if false;
      }

      // Plaid access tokens and cursors are server-only, even to the owner.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // No other collection is exposed to client SDK access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
